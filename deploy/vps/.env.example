# UFUQ single-server settings. setup-server.sh copies this to .env and fills
# every secret with a fresh random value. Never commit .env.

# Public domain (served through Cloudflare).
UFUQ_DOMAIN=1to1os.com

# Secrets — generated by setup-server.sh. Letters/digits only (URL-safe).
POSTGRES_PASSWORD=
UFUQ_APP_DB_SECRET=
MINIO_ROOT_USER=ufuq
MINIO_ROOT_PASSWORD=

# Seed the demo company "Al-Nour Trading & Distribution" once, on an empty
# database (admin: admin.kadry@demo.ufuq.local). Set false for real customers.
DEMO_SEED=true

# Heap per Node process (API and web), in MB.
NODE_HEAP_MB=768

# Mail. Defaults deliver to the in-stack Mailpit sink (nothing is sent).
# For real mail, set a relay here, e.g. SMTP_HOST=smtp.example.com SMTP_PORT=587.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Ufuq <no-reply@1to1os.com>
# Public contact form recipient. Empty = the form answers "unavailable".
CONTACT_TO=

# Backups (./backups on the server).
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=1

{
  "name": "@ufuq/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "lint": "eslint index.ts src",
    "test": "vitest run",
    "bundle:check": "expo export --platform android --no-bytecode --output-dir .expo/bundle-check"
  },
  "dependencies": {
    "@ufuq/design-tokens": "workspace:*",
    "@ufuq/i18n": "workspace:*",
    "babel-preset-expo": "~57.0.0",
    "expo": "57.0.20",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@ufuq/eslint-config": "workspace:*",
    "@ufuq/tsconfig": "workspace:*",
    "react-dom": "19.2.3",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}

{
  "name": "@ufuq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false && tsc -p test/tsconfig.json --noEmit --incremental false",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@ufuq/auth": "workspace:*",
    "@ufuq/config": "workspace:*",
    "@ufuq/db": "workspace:*",
    "@ufuq/i18n": "workspace:*",
    "@ufuq/money": "workspace:*",
    "bullmq": "^6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@nestjs/testing": "12.0.1",
    "@swc/core": "1.16.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.7.9",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "@ufuq/eslint-config": "workspace:*",
    "@ufuq/tsconfig": "workspace:*",
    "supertest": "7.2.2",
    "typescript": "5.6.3",
    "unplugin-swc": "1.5.11",
    "vitest": "2.1.3"
  }
}

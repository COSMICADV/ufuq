// أُفق — Phase 3 database schema (DOCUMENT 06, DOCUMENT 09, DOCUMENT 21).
//
// Only the entities Phase 3 owns exist here: companies (the tenant root),
// the authentication identity tables, and audit_logs. Every later phase adds
// its own tables in its own migration — this file is not a preview of the
// full DOCUMENT 06 catalogue.
//
// `directUrl` is used only by the Prisma CLI (migrate, introspect) and points
// at the database-owner role that may create roles, functions and RLS
// policies. `url` is what PrismaClient connects with at runtime, and points
// at `ufuq_app` — a role with no privileges RLS does not already constrain
// (AD-03, DOCUMENT 20 §3). See migration.sql for why the two must differ.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_MIGRATION_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CompanyStatus {
  active
  suspended
  cancelled

  @@map("company_status")
}

enum UserStatus {
  invited
  active
  deactivated

  @@map("user_status")
}

/// DOCUMENT 02 §3.
enum PermissionScope {
  self
  team
  company
  platform

  @@map("permission_scope")
}

/// OD-02 — one `sessions` table serves both the cookie-based web client and
/// the token-based mobile client; this tells a row apart.
enum SessionClientType {
  web
  mobile

  @@map("session_client_type")
}

/// DOCUMENT 06 §3.4. Two values only — `inactive` is a lifecycle state an
/// admin chooses, distinct from `deleted_at`, which is the soft-delete
/// tombstone. No third value exists until a product decision adds one.
enum DepartmentStatus {
  active
  inactive

  @@map("department_status")
}

/// DOCUMENT 06 §3.7, DOCUMENT 12 business rule 6. What the schedule does with
/// minutes worked beyond the scheduled day; the calculation itself is Phase 6.
enum OvertimePolicy {
  none
  paid
  banked

  @@map("overtime_policy")
}

/// DOCUMENT 06 §3.6. `inactive` is a reversible administrative state (the
/// `POST /employees/{id}/deactivate` and `/activate` pair); `terminated` is the
/// end of employment and carries `termination_date`. No Phase 5 endpoint
/// reaches `terminated` — see docs/PHASE-5-STATUS.md.
enum EmployeeStatus {
  active
  inactive
  terminated

  @@map("employee_status")
}

/// DOCUMENT 06 §3.10, DOCUMENT 12. A *mode*, not a status: a record is
/// `present` with mode `wfh`. Storing "WFH" as a status would make "how many
/// present days were remote?" unanswerable.
enum WorkMode {
  office
  wfh

  @@map("work_mode")
}

/// DOCUMENT 06 §3.10, DOCUMENT 12 "Status values". All eight; every one is
/// reachable in Phase 6 (DOCUMENT 25 Phase 6 exit criterion).
enum AttendanceStatus {
  present
  absent
  late
  on_leave
  half_day
  holiday
  weekend
  pending

  @@map("attendance_status")
}

/// DOCUMENT 12 "Source values" — what wrote the row. `system` covers the
/// nightly absence job and the weekend/holiday generation.
enum AttendanceSource {
  self
  admin
  correction
  system

  @@map("attendance_source")
}

/// DOCUMENT 06 §3.11.
enum CorrectionStatus {
  pending
  approved
  rejected
  cancelled

  @@map("correction_status")
}

/// DOCUMENT 06 §3.15, DOCUMENT 13 "Statuses". There is no `overdue`: it is
/// derived from the deadline on read and can never be stored or set
/// (DOCUMENT 13 rule 1).
enum TaskStatus {
  not_started
  in_progress
  completed
  cancelled
  on_hold

  @@map("task_status")
}

/// DOCUMENT 06 §3.15, DOCUMENT 13 "Priorities".
enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

/// DOCUMENT 06 §3.18, DOCUMENT 14 "Types". DOCUMENT 14: "The enum is
/// extensible; adding a type must not require touching progress calculation
/// for existing types."
enum GoalType {
  sales
  task
  custom

  @@map("goal_type")
}

/// DOCUMENT 14 "Statuses".
enum GoalStatus {
  active
  achieved
  missed
  cancelled

  @@map("goal_status")
}

/// DOCUMENT 06 §3.19 — who produced a history row: a person's update
/// (`manual`) or a derivation the system made (`system`).
enum GoalProgressSource {
  manual
  system

  @@map("goal_progress_source")
}

/// DOCUMENT 06 §3.20 — the five Requests Centre categories (DOCUMENT 01
/// FR-08.1). Attendance and leave rows index a specialised record (OD-09).
enum RequestCategory {
  attendance
  leave
  salary
  task
  general

  @@map("request_category")
}

/// DOCUMENT 01 FR-08.3.
enum RequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("request_status")
}

/// DOCUMENT 06 §3.12 / DOCUMENT 16 rule 13.
enum LeaveCarryOverPolicy {
  none
  full
  capped

  @@map("leave_carry_over_policy")
}

/// DOCUMENT 06 §3.22.
enum DailyWageBasis {
  fixed_days
  scheduled_working_days
  calendar_days

  @@map("daily_wage_basis")
}

enum UnpaidLeaveDeductionRule {
  daily_wage
  scheduled_day_wage
  none

  @@map("unpaid_leave_deduction_rule")
}

enum AbsenceDeductionRule {
  daily_wage
  none

  @@map("absence_deduction_rule")
}

enum PayrollRounding {
  none
  nearest
  up
  down

  @@map("payroll_rounding")
}

/// DOCUMENT 06 §3.23, DOCUMENT 15 "PAYROLL STATES".
enum PayrollPeriodStatus {
  draft
  under_review
  approved
  finalized
  paid
  adjusted

  @@map("payroll_period_status")
}

/// `needs_review`: DOCUMENT 15 "Employee with zero attendance … flagged for review".
enum PayrollLineStatus {
  calculated
  needs_review

  @@map("payroll_line_status")
}

/// DOCUMENT 06 §3.14.
enum LeaveRequestStatus {
  pending
  approved
  rejected
  cancelled

  @@map("leave_request_status")
}


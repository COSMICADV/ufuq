// ---------------------------------------------------------------------------
// Tenant root
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.1. The tenant root — every other table in the system
/// eventually carries `company_id`, directly or through a chain of FKs.
model Company {
  id                   String        @id @db.Uuid
  name                 String        @db.VarChar(200)
  slug                 String        @unique @db.VarChar(100)
  logoPath             String?       @map("logo_path") @db.VarChar(500)
  timezone             String        @db.VarChar(64)
  currency             String        @default("EGP") @db.Char(3)
  defaultLocale        String        @default("ar") @map("default_locale") @db.Char(5)
  fiscalMonthStartDay  Int           @default(1) @map("fiscal_month_start_day") @db.SmallInt
  /// DOCUMENT 12 rule 13 — "corrections have a window, default 7 days,
  /// configurable per company". The default here is DOCUMENT 12's own number;
  /// a CHECK requires at least 1 and sets no maximum (see the Phase 6
  /// critical-fix migration).
  correctionWindowDays Int           @default(7) @map("correction_window_days") @db.SmallInt
  /// DOCUMENT 17 rule 5 — outbound movements may take a location below zero
  /// only when this is true (Phase 14). Default false: blocked.
  allowNegativeStock   Boolean       @default(false) @map("allow_negative_stock")
  status               CompanyStatus @default(active)
  /// Nullable: Phase 3 has no registration flow yet (DOCUMENT 25 Phase 16).
  createdBy            String?       @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt            DateTime?     @map("deleted_at") @db.Timestamptz(3)

  users         User[]
  roles         Role[]
  sessions      Session[]
  auditLogs     AuditLog[]
  departments   Department[]
  positions     Position[]
  workSchedules WorkSchedule[]
  holidays      Holiday[]
  employees     Employee[]

  attendanceRecords  AttendanceRecord[]
  correctionRequests AttendanceCorrectionRequest[]

  tasks Task[]

  attachments Attachment[]

  goals             Goal[]
  performanceConfig PerformanceConfig?

  requests Request[]

  leaveTypes    LeaveType[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  salaryPolicies     SalaryPolicy[]
  employeeSalaries   EmployeeSalary[]
  payrollPeriods     PayrollPeriod[]
  payrollLines       PayrollLine[]
  payrollDeductions  PayrollDeduction[]
  payrollBonuses     PayrollBonus[]
  payrollAdjustments PayrollAdjustment[]
  idempotencyKeys    IdempotencyKey[]

  warehouses        Warehouse[]
  products          Product[]
  productStock      ProductStock[]
  productCategories ProductCategory[]
  suppliers         Supplier[]
  stockMovements    StockMovement[]

  monthlyReports MonthlyEmployeeReport[]
  reportExports  ReportExport[]

  notifications           Notification[]
  notificationEvents      NotificationEvent[]
  notificationPreferences CompanyNotificationSetting[]

  @@index([status])
  @@map("companies")
}

// ---------------------------------------------------------------------------
// Company structure — Phase 4 (DOCUMENT 06 §3.4–3.9, DOCUMENT 12)
//
// `departments.manager_employee_id` (DOCUMENT 06 §3.4) arrived with Phase 5,
// as an enforced reference to `employees` (approved Phase 4 decision) rather
// than an unenforced UUID added ahead of the table it points at.
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.4. `parentId` makes the tree possible; nothing in V1 builds
/// a nested department UI, but the column is specified and the service
/// prevents cycles, so a tree cannot become invalid data later.
model Department {
  id                String           @id @db.Uuid
  companyId         String           @map("company_id") @db.Uuid
  nameAr            String           @map("name_ar") @db.VarChar(200)
  nameEn            String           @map("name_en") @db.VarChar(200)
  parentId          String?          @map("parent_id") @db.Uuid
  /// Phase 5. Same-company is enforced by a trigger as well as by the service
  /// (see the Phase 5 migration for why a foreign key alone is not enough).
  managerEmployeeId String?          @map("manager_employee_id") @db.Uuid
  status            DepartmentStatus @default(active)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// DOCUMENT 06 §6 — reference data is soft-deleted; historical records keep
  /// pointing at it.
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamptz(3)

  company   Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent    Department?  @relation("department_tree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("department_tree")
  positions Position[]
  manager   Employee?    @relation("department_manager", fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  employees Employee[]   @relation("employee_department")
  tasks     Task[]

  // DOCUMENT 06 §3.4 states this unique constraint without a soft-delete
  // predicate, so it is written exactly as specified: a soft-deleted
  // department continues to hold its Arabic name.
  @@unique([companyId, nameAr])
  @@index([companyId, status])
  @@map("departments")
}

/// DOCUMENT 06 §3.5.
model Position {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  titleAr      String    @map("title_ar") @db.VarChar(200)
  titleEn      String    @map("title_en") @db.VarChar(200)
  departmentId String?   @map("department_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employees  Employee[]

  @@index([companyId, departmentId])
  @@map("positions")
}

/// DOCUMENT 06 §3.7, DOCUMENT 12. The whole point of this table is DOCUMENT 27
/// RULE 12: there is no `WORKING_DAYS` constant anywhere in this codebase, and
/// no schedule value has a code-level default beyond the column defaults
/// DOCUMENT 06 itself specifies.
model WorkSchedule {
  id                    String         @id @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  name                  String         @db.VarChar(200)
  isDefault             Boolean        @default(false) @map("is_default")
  /// The schedule's own IANA zone (DOCUMENT 06 §3.7) — attendance is evaluated
  /// against it, never against the browser's zone (DOCUMENT 12, timezone).
  timezone              String         @db.VarChar(64)
  gracePeriodMinutes    Int            @default(0) @map("grace_period_minutes")
  /// DECIMAL rather than an integer: a 4.5-hour half-day threshold is ordinary,
  /// and DOCUMENT 06 §3.8 names the column without fixing a type. Rounding a
  /// company's configuration to whole hours would be exactly the code-level
  /// constraint on configuration DOCUMENT 27 RULE 12 forbids.
  halfDayThresholdHours Decimal        @map("half_day_threshold_hours") @db.Decimal(4, 2)
  overtimePolicy        OvertimePolicy @default(none) @map("overtime_policy")
  breakMinutes          Int            @default(0) @map("break_minutes")
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?      @map("deleted_at") @db.Timestamptz(3)

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  days      WorkScheduleDay[]
  employees Employee[]

  @@index([companyId, isDefault])
  @@map("work_schedules")
}

/// DOCUMENT 06 §3.8. Seven rows per schedule, one per weekday — a missing row
/// would mean "this day is undefined", and an undefined day is precisely what
/// tempts a later phase to fall back to a hardcoded default.
///
/// No `company_id`: tenancy comes through `workScheduleId`, and the row-level
/// security policy in migration.sql enforces it through that parent rather
/// than through a duplicated column that could drift.
model WorkScheduleDay {
  id             String    @id @db.Uuid
  workScheduleId String    @map("work_schedule_id") @db.Uuid
  /// 0 = Sunday … 6 = Saturday, matching PostgreSQL's `EXTRACT(DOW)`.
  dayOfWeek      Int       @map("day_of_week") @db.SmallInt
  isWorkingDay   Boolean   @map("is_working_day")
  /// Null exactly when `isWorkingDay` is false — enforced by a CHECK constraint.
  startTime      DateTime? @map("start_time") @db.Time(0)
  endTime        DateTime? @map("end_time") @db.Time(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)

  @@unique([workScheduleId, dayOfWeek])
  @@map("work_schedule_days")
}

/// DOCUMENT 06 §3.9, DOCUMENT 12. Company-level dates excluded from working
/// days. DOCUMENT 06 §3.9 specifies no `deleted_at`, so a holiday is removed
/// outright rather than soft-deleted — and DOCUMENT 08 §4.2 defines no delete
/// endpoint, so nothing in Phase 4 removes one (see docs/PHASE-4-STATUS.md).
model Holiday {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  date        DateTime @db.Date
  nameAr      String   @map("name_ar") @db.VarChar(200)
  nameEn      String   @map("name_en") @db.VarChar(200)
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Employees — Phase 5 (DOCUMENT 06 §3.6)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.6. The employment record, separate from `users` because
/// employment data outlives and differs from login identity.
///
/// Salary is not a column here and never will be — DOCUMENT 06 §3.21 keeps it
/// as history in `employee_salaries` (Phase 11). Leave allowances live in
/// `leave_balances` (Phase 10).
///
/// Every reference (`user_id`, `department_id`, `position_id`, `manager_id`,
/// `work_schedule_id`) must belong to the same company. The service checks
/// that first; a trigger in the Phase 5 migration refuses the write if it
/// ever does not, because a foreign key alone is checked without row-level
/// security and would accept another tenant's id.
model Employee {
  id              String         @id @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  /// Nullable — "an employee may exist before an account" (DOCUMENT 06 §3.6).
  /// Phase 5 always creates one (approved decision, FLOW 02).
  userId          String?        @unique @map("user_id") @db.Uuid
  employeeCode    String         @map("employee_code") @db.VarChar(50)
  firstName       String         @map("first_name") @db.VarChar(100)
  lastName        String         @map("last_name") @db.VarChar(100)
  photoPath       String?        @map("photo_path") @db.VarChar(500)
  email           String?        @db.VarChar(255)
  phone           String?        @db.VarChar(32)
  departmentId    String?        @map("department_id") @db.Uuid
  positionId      String?        @map("position_id") @db.Uuid
  managerId       String?        @map("manager_id") @db.Uuid
  workScheduleId  String         @map("work_schedule_id") @db.Uuid
  joiningDate     DateTime       @map("joining_date") @db.Date
  status          EmployeeStatus @default(active)
  terminationDate DateTime?      @map("termination_date") @db.Date
  createdBy       String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department         Department?  @relation("employee_department", fields: [departmentId], references: [id], onDelete: Restrict)
  position           Position?    @relation(fields: [positionId], references: [id], onDelete: Restrict)
  manager            Employee?    @relation("employee_manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]   @relation("employee_manager")
  workSchedule       WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  managedDepartments Department[] @relation("department_manager")

  attendanceRecords  AttendanceRecord[]
  correctionRequests AttendanceCorrectionRequest[]

  assignedTasks   Task[]
  progressUpdates TaskProgressUpdate[]

  goals Goal[]

  requests Request[]

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  salaries           EmployeeSalary[]
  payrollLines       PayrollLine[]
  payrollAdjustments PayrollAdjustment[]

  monthlyReports MonthlyEmployeeReport[]

  @@unique([companyId, employeeCode])
  @@unique([companyId, email])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  @@index([managerId])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Roles & permissions — DOCUMENT 02, DOCUMENT 06 §3.3
// ---------------------------------------------------------------------------

/// `companyId = null` is a system role, shared by every company (DOCUMENT 06
/// §3.3). V1 seeds the four DOCUMENT 02 §2 roles as system roles and builds
/// no UI to create a company-specific one — the column exists so adding that
/// later is additive, per the OD-01-style "schema ready, feature deferred"
/// pattern this package follows throughout.
model Role {
  id        String   @id @db.Uuid
  companyId String?  @map("company_id") @db.Uuid
  key       String   @db.VarChar(50)
  nameEn    String   @map("name_en") @db.VarChar(100)
  nameAr    String   @map("name_ar") @db.VarChar(100)
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Cascade, not the nullable-column default of SET NULL: if a company that
  // owns a custom role is ever hard-deleted, that role must not survive and
  // silently become a shared system role for every other company.
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users           User[]
  rolePermissions RolePermission[]

  // A per-company unique (company_id, key) is expressed here; the additional
  // "at most one system role per key" rule needs a filtered index Prisma's
  // DSL cannot express and is added by hand in migration.sql.
  @@unique([companyId, key])
  @@map("roles")
}

/// DOCUMENT 06 §3.3. Platform-wide reference data — not company-scoped, so it
/// carries no `company_id` and no RLS policy (there is nothing to isolate).
model Permission {
  id            String   @id @db.Uuid
  key           String   @unique @db.VarChar(100)
  module        String   @db.VarChar(50)
  descriptionEn String   @map("description_en") @db.VarChar(255)
  descriptionAr String   @map("description_ar") @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// DOCUMENT 06 §3.3. Composite PK, no surrogate id — the pair *is* the
/// identity, exactly as documented.
model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Authentication identity — DOCUMENT 06 §3.2, DOCUMENT 09
// ---------------------------------------------------------------------------

model User {
  id                String     @id @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  email             String     @db.VarChar(255)
  /// Null until the invitation is accepted (DOCUMENT 09 §6).
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  roleId            String     @map("role_id") @db.Uuid
  /// Overrides `company.defaultLocale` when set (DOCUMENT 06 §3.2).
  locale            String?    @db.Char(5)
  status            UserStatus @default(invited)
  /// DOCUMENT 21 "Record content" — the designated actor for system-generated
  /// rows. It can never authenticate: `auth_lookup_login` does not return it,
  /// it may hold no password hash, and there is at most one per company. See
  /// the Phase 6 final-fix migration.
  isSystem          Boolean    @default(false) @map("is_system")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount  Int        @default(0) @map("failed_login_count") @db.SmallInt
  /// Not in DOCUMENT 06 §3.2's field list — added because the DOCUMENT 09 §1
  /// lockout rule it exists to support ("5 failures within 15 minutes") is
  /// not expressible from `failedLoginCount` alone: without a timestamp to
  /// measure the window from, a count can only ever mean "since the last
  /// success," a stricter and different rule than the one specified. See the
  /// Phase 3 report.
  lastFailedLoginAt DateTime?  @map("last_failed_login_at") @db.Timestamptz(3)
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  /// The admin who invited this user. Null for the seed-created first admin.
  createdBy         String?    @map("created_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(3)

  company             Company                       @relation(fields: [companyId], references: [id])
  role                Role                          @relation(fields: [roleId], references: [id])
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitation          Invitation?
  auditLogs           AuditLog[]
  employee            Employee?
  attendanceCreated   AttendanceRecord[]            @relation("attendance_created_by")
  correctionsReviewed AttendanceCorrectionRequest[] @relation("correction_reviewed_by")
  tasksCreated        Task[]                        @relation("task_created_by")
  checklistCompleted  TaskChecklistItem[]           @relation("checklist_completed_by")
  progressUpdates     TaskProgressUpdate[]          @relation("progress_update_created_by")
  attachmentsUploaded Attachment[]                  @relation("attachment_uploaded_by")
  goalsCreated        Goal[]                        @relation("goal_created_by")
  goalProgressCreated GoalProgress[]                @relation("goal_progress_created_by")
  performanceConfigs  PerformanceConfig[]           @relation("performance_config_updated_by")
  requestsReviewed    Request[]                     @relation("request_reviewed_by")
  leaveReviewed       LeaveRequest[]                @relation("leave_reviewed_by")
  salariesCreated     EmployeeSalary[]              @relation("salary_created_by")
  payrollsGenerated   PayrollPeriod[]               @relation("payroll_generated_by")
  payrollsFinalized   PayrollPeriod[]               @relation("payroll_finalized_by")
  deductionsCreated   PayrollDeduction[]            @relation("deduction_created_by")
  bonusesCreated      PayrollBonus[]                @relation("bonus_created_by")
  adjustmentsCreated  PayrollAdjustment[]           @relation("adjustment_created_by")
  adjustmentsApproved PayrollAdjustment[]           @relation("adjustment_approved_by")
  idempotencyKeys     IdempotencyKey[]
  stockMovements      StockMovement[]               @relation("stock_movement_created_by")
  monthlyReports      MonthlyEmployeeReport[]       @relation("monthly_report_generated_by")
  reportExports       ReportExport[]                @relation("report_export_requested_by")
  notifications       Notification[]
  notificationPrefs   CompanyNotificationSetting[]  @relation("notification_setting_updated_by")

  // Never unique on email alone — DOCUMENT 06 §3.2: "the same person may
  // exist in two companies later."
  @@unique([companyId, email])
  @@index([companyId, status])
  @@map("users")
}

/// DOCUMENT 06 §3.37, DOCUMENT 09 §3. One row per authenticated session,
/// whichever client created it (OD-02). `tokenHash` is what the cookie value
/// (web) or the access token (mobile) hashes to; `refreshTokenHash` is set
/// only for mobile rows.
model Session {
  id               String            @id @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  clientType       SessionClientType @map("client_type")
  tokenHash        String            @unique @map("token_hash") @db.VarChar(64)
  refreshTokenHash String?           @unique @map("refresh_token_hash") @db.VarChar(64)
  /// Web only — extends the absolute timeout from 24h to 30 days (DOCUMENT 09 §3).
  rememberMe       Boolean           @default(false) @map("remember_me")
  ipAddress        String?           @map("ip_address") @db.VarChar(45)
  userAgent        String?           @map("user_agent") @db.VarChar(500)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt       DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute timeout — fixed at creation, never extended.
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

/// DOCUMENT 06 §3.37, DOCUMENT 09 §2. One row per reset request; a new
/// request invalidates the previous unused one (service-layer rule, not a
/// database constraint — DOCUMENT 06 keeps the history).
model PasswordResetToken {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// DOCUMENT 06 §3.37, DOCUMENT 09 §6. One row per user — a resend overwrites
/// `tokenHash` and `expiresAt` in place, which is what "the old token is
/// invalidated" means in a single-row model. `invitedBy` is who sent it.
///
/// Nothing in Phase 3 creates one over HTTP: an admin *sending* an invitation
/// is part of employee creation (Phase 5, `POST /employees`). This table and
/// `POST /auth/accept-invitation` exist now because DOCUMENT 25 Phase 3 scopes
/// "invitation acceptance" here; see the Phase 3 report for how this is
/// exercised before Phase 5 exists.
model Invitation {
  id         String    @id @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  invitedBy  String?   @map("invited_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Audit — DOCUMENT 06 §3.35, DOCUMENT 21
// ---------------------------------------------------------------------------

/// Append-only. No update or delete path exists anywhere in this package —
/// DOCUMENT 21 requires the database itself to refuse them (see
/// migration.sql), not just application discipline.
model AuditLog {
  id         String      @id @db.Uuid
  companyId  String      @map("company_id") @db.Uuid
  /// The acting user. System actions record a designated system user,
  /// never null (DOCUMENT 21 "Record content").
  userId     String      @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String      @map("entity_id") @db.Uuid
  oldValues  Json?       @map("old_values")
  newValues  Json?       @map("new_values")
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(500)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([companyId, action, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Attendance — Phase 6 (DOCUMENT 06 §3.10–3.11, DOCUMENT 12)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.10, DOCUMENT 12. One row per employee per day — the unique
/// constraint is what makes a double check-in a clean 409 rather than two
/// records (DOCUMENT 12 edge case "two devices check in simultaneously").
///
/// The derived columns (`workingMinutes`, `overtimeMinutes`, `lateMinutes`)
/// are stored, not computed on read: payroll and reporting read them for
/// closed months, and a schedule edited later must not silently restate a
/// past month (DOCUMENT 12 edge case "schedule changes mid-month"). They are
/// null until there is something to derive them from.
///
/// `leave_request_id` (DOCUMENT 06 §3.10) arrived with `leave_requests` in
/// Phase 10: approved leave writes `on_leave` days linked back to the request
/// (DOCUMENT 12 rule 8, DOCUMENT 16 rule 5).
model AttendanceRecord {
  id              String           @id @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  employeeId      String           @map("employee_id") @db.Uuid
  date            DateTime         @db.Date
  /// Null when the day was not worked — absent, on leave, a holiday or a
  /// weekend (DOCUMENT 06 §3.10).
  workMode        WorkMode?        @map("work_mode")
  checkInAt       DateTime?        @map("check_in_at") @db.Timestamptz(3)
  checkOutAt      DateTime?        @map("check_out_at") @db.Timestamptz(3)
  workingMinutes  Int?             @map("working_minutes")
  overtimeMinutes Int?             @map("overtime_minutes")
  lateMinutes     Int?             @map("late_minutes")
  status          AttendanceStatus
  source          AttendanceSource
  note            String?          @db.Text
  /// Null for rows the system generated — there is no acting human to name
  /// (DOCUMENT 12 "source values": `system`).
  createdBy       String?          @map("created_by") @db.Uuid
  leaveRequestId  String?          @map("leave_request_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser User?    @relation("attendance_created_by", fields: [createdBy], references: [id], onDelete: SetNull)

  corrections AttendanceCorrectionRequest[]

  @@unique([employeeId, date])
  @@index([companyId, date])
  @@index([employeeId, date])
  @@index([companyId, status, date])
  @@map("attendance_records")
}

/// DOCUMENT 06 §3.11, DOCUMENT 12. `attendanceRecordId` is nullable because
/// the day being corrected may have no record at all — the "employee forgot
/// to check in" case DOCUMENT 12 validation sends here.
///
/// `attachment_id` (DOCUMENT 06 §3.11) is **not** here: attachments are
/// DOCUMENT 08 §4.14 and no phase has built them. Same reasoning as
/// `leave_request_id` above.
model AttendanceCorrectionRequest {
  id                 String           @id @db.Uuid
  companyId          String           @map("company_id") @db.Uuid
  employeeId         String           @map("employee_id") @db.Uuid
  attendanceRecordId String?          @map("attendance_record_id") @db.Uuid
  date               DateTime         @db.Date
  requestedCheckIn   DateTime?        @map("requested_check_in") @db.Timestamptz(3)
  requestedCheckOut  DateTime?        @map("requested_check_out") @db.Timestamptz(3)
  requestedWorkMode  WorkMode?        @map("requested_work_mode")
  reason             String           @db.Text
  status             CorrectionStatus @default(pending)
  reviewedBy         String?          @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote         String?          @map("review_note") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  reviewer         User?             @relation("correction_reviewed_by", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([companyId, status, date])
  @@index([employeeId, date])
  @@map("attendance_correction_requests")
}

// ---------------------------------------------------------------------------
// Tasks — Phase 7 (DOCUMENT 06 §3.15–3.17, DOCUMENT 13)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.15, DOCUMENT 13.
///
/// `progressPercent` is derived, never free-typed (DOCUMENT 06 §1.3): the
/// service recomputes it from the checklist, or from the status when there is
/// no checklist (OD-10, approved default — see docs/PHASE-7-STATUS.md).
///
/// `goal_id` (DOCUMENT 06 §3.15) is deliberately **not** here: it is a foreign
/// key to `goals`, which Phase 8 creates. An unenforced UUID column now is the
/// shortcut that never gets fixed — the reasoning that kept
/// `attendance_records.leave_request_id` out of Phase 6.
model Task {
  id                 String       @id @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  title              String       @db.VarChar(255)
  description        String?      @db.Text
  assigneeEmployeeId String       @map("assignee_employee_id") @db.Uuid
  departmentId       String?      @map("department_id") @db.Uuid
  priority           TaskPriority
  status             TaskStatus   @default(not_started)
  startDate          DateTime?    @map("start_date") @db.Date
  deadline           DateTime?    @db.Date
  completedAt        DateTime?    @map("completed_at") @db.Timestamptz(3)
  progressPercent    Decimal      @default(0) @map("progress_percent") @db.Decimal(5, 2)
  createdBy          String       @map("created_by") @db.Uuid
  cancelledReason    String?      @map("cancelled_reason") @db.Text
  /// DOCUMENT 06 §3.15, added in Phase 8 with the table it points at.
  /// DOCUMENT 13: `SET NULL` on goal deletion.
  goalId             String?      @map("goal_id") @db.Uuid
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// DOCUMENT 06 §6 — tasks are soft-deleted for reporting integrity.
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(3)

  company       Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignee      Employee    @relation(fields: [assigneeEmployeeId], references: [id], onDelete: Restrict)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdByUser User        @relation("task_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  goal          Goal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)

  checklistItems  TaskChecklistItem[]
  progressUpdates TaskProgressUpdate[]

  @@index([companyId, status])
  @@index([assigneeEmployeeId, status])
  @@index([companyId, deadline])
  @@index([goalId, status])
  @@index([companyId, createdAt])
  @@map("tasks")
}

/// DOCUMENT 06 §3.16. No `company_id`: DOCUMENT 06 does not define one, and
/// tenancy is reached through the parent task — the `work_schedule_days`
/// pattern from Phase 4.
model TaskChecklistItem {
  id          String    @id @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  title       String    @db.VarChar(255)
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  /// The user who ticked it. Null while the item is open.
  completedBy String?   @map("completed_by") @db.Uuid
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  task            Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedByUser User? @relation("checklist_completed_by", fields: [completedBy], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@map("task_checklist_items")
}

/// DOCUMENT 06 §3.17. Append-only (DOCUMENT 13 rule 9): the application role
/// holds neither UPDATE nor DELETE on this table.
///
/// `employeeId` is the author's employee record and is nullable because an
/// administrator account need not have one; `createdBy` (DOCUMENT 06 §1.6) is
/// the acting user and is always present.
model TaskProgressUpdate {
  id                    String   @id @db.Uuid
  taskId                String   @map("task_id") @db.Uuid
  employeeId            String?  @map("employee_id") @db.Uuid
  note                  String   @db.Text
  progressPercentAtTime Decimal  @map("progress_percent_at_time") @db.Decimal(5, 2)
  createdBy             String   @map("created_by") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser User      @relation("progress_update_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_progress_updates")
}

// ---------------------------------------------------------------------------
// Attachments — Phase 7 addendum (DOCUMENT 06 §3.36, DOCUMENT 08 §4.14,
// DOCUMENT 20 §7, AD-02)
// ---------------------------------------------------------------------------

/// One stored file. The bytes live in private S3-compatible storage under
/// `stored_path` — a generated, company-namespaced, non-guessable key — and are
/// only ever served through the authorization-checked `GET /attachments/{id}`.
/// `original_name` is metadata, never a path (DOCUMENT 20 §4). `related_type` /
/// `related_id` name the record the file belongs to, and that record's own
/// scope rules decide who may see it; only `task` exists in Phase 7.
model Attachment {
  id           String    @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  uploadedBy   String    @map("uploaded_by") @db.Uuid
  originalName String    @map("original_name") @db.VarChar(255)
  storedPath   String    @unique @map("stored_path") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(127)
  sizeBytes    Int       @map("size_bytes")
  /// SHA-256 of the stored bytes, lowercase hex.
  checksum     String    @db.Char(64)
  relatedType  String    @map("related_type") @db.VarChar(50)
  relatedId    String    @map("related_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  uploader User    @relation("attachment_uploaded_by", fields: [uploadedBy], references: [id], onDelete: Restrict)

  leaveRequests LeaveRequest[]

  @@index([companyId, relatedType, relatedId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Goals & performance — Phase 8 (DOCUMENT 06 §3.18–3.19, DOCUMENT 14)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.18. `currentValue` is a cache of the latest `goal_progress`
/// row (DOCUMENT 14 rule 5); progress is computed, never stored (DOCUMENT 06
/// §3.18). `taskCountRule` is present exactly when `type` is `task`.
model Goal {
  id            String     @id @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  employeeId    String     @map("employee_id") @db.Uuid
  type          GoalType
  title         String     @db.VarChar(255)
  description   String?    @db.Text
  targetValue   Decimal    @map("target_value") @db.Decimal(15, 2)
  currentValue  Decimal    @default(0) @map("current_value") @db.Decimal(15, 2)
  unit          String     @db.VarChar(20)
  periodStart   DateTime   @map("period_start") @db.Date
  periodEnd     DateTime   @map("period_end") @db.Date
  status        GoalStatus @default(active)
  taskCountRule Json?      @map("task_count_rule")
  createdBy     String     @map("created_by") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// DOCUMENT 06 §6 — goals are soft-deleted for reporting integrity.
  deletedAt     DateTime?  @map("deleted_at") @db.Timestamptz(3)

  company       Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdByUser User     @relation("goal_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  progress GoalProgress[]
  tasks    Task[]

  @@index([companyId, employeeId, status])
  @@index([companyId, periodEnd])
  @@map("goals")
}

/// DOCUMENT 06 §3.19 — append-only history. The database refuses UPDATE and
/// DELETE for every role. `targetValue` is the target in effect when the row
/// was written (DOCUMENT 14 "Target changed mid-period"). No `company_id`:
/// tenancy is reached through the goal.
model GoalProgress {
  id            String             @id @db.Uuid
  goalId        String             @map("goal_id") @db.Uuid
  value         Decimal            @db.Decimal(15, 2)
  previousValue Decimal?           @map("previous_value") @db.Decimal(15, 2)
  targetValue   Decimal            @map("target_value") @db.Decimal(15, 2)
  note          String?            @db.Text
  source        GoalProgressSource
  createdBy     String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  goal          Goal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  createdByUser User @relation("goal_progress_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([goalId, createdAt])
  @@map("goal_progress")
}

/// DOCUMENT 14 "Database requirements": per-company structured JSON with a
/// schema version. One row per company, written by the database when the
/// company is created (the documented default model) and only updated after.
model PerformanceConfig {
  id            String   @id @db.Uuid
  companyId     String   @unique @map("company_id") @db.Uuid
  schemaVersion Int      @map("schema_version")
  config        Json
  updatedBy     String?  @map("updated_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company       Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  updatedByUser User?   @relation("performance_config_updated_by", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("performance_config")
}

// ---------------------------------------------------------------------------
// Requests — Phase 9 (DOCUMENT 06 §3.20, DOCUMENT 08 §4.9, OD-09)
// ---------------------------------------------------------------------------

/// The unified Requests Centre. Salary, task and general requests live here
/// entirely; an attendance (and, from Phase 10, leave) row is the inbox entry
/// for a specialised record, written and kept in step by a database trigger.
/// `related_id` is polymorphic, so it has no Prisma relation; the database
/// checks it by type (`requests_same_company`).
model Request {
  id            String          @id @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  category      RequestCategory
  subject       String?         @db.VarChar(255)
  description   String?         @db.Text
  relatedType   String?         @map("related_type") @db.VarChar(50)
  relatedId     String?         @map("related_id") @db.Uuid
  status        RequestStatus   @default(pending)
  reviewedBy    String?         @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  adminResponse String?         @map("admin_response") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer User?    @relation("request_reviewed_by", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@unique([relatedType, relatedId])
  @@index([companyId, status, createdAt])
  @@index([employeeId, createdAt])
  @@map("requests")
}

// ---------------------------------------------------------------------------
// Leave — Phase 10 (DOCUMENT 06 §3.12–3.14, DOCUMENT 16)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.12. Seeded per company by the database (Annual, Sick,
/// Emergency, Unpaid, Other), fully configurable, soft-deleted.
model LeaveType {
  id                    String               @id @db.Uuid
  companyId             String               @map("company_id") @db.Uuid
  nameAr                String               @map("name_ar") @db.VarChar(100)
  nameEn                String               @map("name_en") @db.VarChar(100)
  isPaid                Boolean              @default(true) @map("is_paid")
  defaultDaysPerYear    Decimal              @default(0) @map("default_days_per_year") @db.Decimal(5, 2)
  requiresAttachment    Boolean              @default(false) @map("requires_attachment")
  allowsNegativeBalance Boolean              @default(false) @map("allows_negative_balance")
  carryOverPolicy       LeaveCarryOverPolicy @default(none) @map("carry_over_policy")
  carryOverCap          Decimal?             @map("carry_over_cap") @db.Decimal(5, 2)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?            @map("deleted_at") @db.Timestamptz(3)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@index([companyId])
  @@map("leave_types")
}

/// DOCUMENT 06 §3.13. `remaining = total + carried_over − used − pending` is
/// computed, never stored.
model LeaveBalance {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  leaveTypeId        String    @map("leave_type_id") @db.Uuid
  year               Int       @db.SmallInt
  totalDays          Decimal   @default(0) @map("total_days") @db.Decimal(5, 2)
  usedDays           Decimal   @default(0) @map("used_days") @db.Decimal(5, 2)
  pendingDays        Decimal   @default(0) @map("pending_days") @db.Decimal(5, 2)
  carriedOverDays    Decimal   @default(0) @map("carried_over_days") @db.Decimal(5, 2)
  /// Set when the annual carry-over job wrote `carried_over_days` (idempotency).
  carryOverAppliedAt DateTime? @map("carry_over_applied_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, leaveTypeId, year])
  @@index([companyId, year])
  @@map("leave_balances")
}

/// DOCUMENT 06 §3.14 — the source of truth for a leave request. Its Requests
/// Centre row is written and kept in step by a database trigger (OD-09).
model LeaveRequest {
  id             String             @id @db.Uuid
  companyId      String             @map("company_id") @db.Uuid
  employeeId     String             @map("employee_id") @db.Uuid
  leaveTypeId    String             @map("leave_type_id") @db.Uuid
  startDate      DateTime           @map("start_date") @db.Date
  endDate        DateTime           @map("end_date") @db.Date
  daysCount      Decimal            @map("days_count") @db.Decimal(5, 2)
  /// Days held per calendar year at submission, e.g. {"2026": "3.00"}.
  yearAllocation Json               @map("year_allocation")
  reason         String             @db.Text
  attachmentId   String?            @map("attachment_id") @db.Uuid
  status         LeaveRequestStatus @default(pending)
  reviewedBy     String?            @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  reviewNote     String?            @map("review_note") @db.Text
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType         LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  reviewer          User?              @relation("leave_reviewed_by", fields: [reviewedBy], references: [id], onDelete: SetNull)
  attachment        Attachment?        @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]

  @@index([companyId, status])
  @@index([employeeId, startDate])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Phase 11 — salary and payroll (DOCUMENT 06 §3.21–3.26, DOCUMENT 15)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.22 — the configurable calculation engine. One per company
/// in V1 (`is_default`). `lateness_rule` is one of
/// `{"type":"none"}`, `{"type":"per_minute","multiplier":"1.00"}`,
/// `{"type":"fixed_per_incident","amount":"50.00"}`.
model SalaryPolicy {
  id                   String                   @id @db.Uuid
  companyId            String                   @map("company_id") @db.Uuid
  name                 String                   @db.VarChar(100)
  dailyWageBasis       DailyWageBasis           @map("daily_wage_basis")
  fixedDaysValue       Int?                     @map("fixed_days_value") @db.SmallInt
  unpaidLeaveDeduction UnpaidLeaveDeductionRule @map("unpaid_leave_deduction")
  absenceDeduction     AbsenceDeductionRule     @map("absence_deduction")
  latenessRule         Json                     @map("lateness_rule")
  overtimeRate         Decimal                  @map("overtime_rate") @db.Decimal(5, 2)
  rounding             PayrollRounding
  isDefault            Boolean                  @default(true) @map("is_default")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salaries EmployeeSalary[]

  @@map("salary_policies")
}

/// DOCUMENT 06 §3.21 — salary history. A change closes the open row and
/// inserts a new one; an amount is never updated (database trigger).
model EmployeeSalary {
  id             String    @id @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  monthlySalary  Decimal   @map("monthly_salary") @db.Decimal(15, 2)
  currency       String    @db.Char(3)
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  salaryPolicyId String    @map("salary_policy_id") @db.Uuid
  createdBy      String    @map("created_by") @db.Uuid
  note           String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryPolicy SalaryPolicy @relation(fields: [salaryPolicyId], references: [id], onDelete: Restrict)
  creator      User         @relation("salary_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([employeeId, effectiveFrom])
  @@index([companyId])
  @@map("employee_salaries")
}

/// DOCUMENT 06 §3.23 — one per company per month.
model PayrollPeriod {
  id                        String              @id @db.Uuid
  companyId                 String              @map("company_id") @db.Uuid
  year                      Int                 @db.SmallInt
  month                     Int                 @db.SmallInt
  startDate                 DateTime            @map("start_date") @db.Date
  endDate                   DateTime            @map("end_date") @db.Date
  status                    PayrollPeriodStatus @default(draft)
  generatedBy               String              @map("generated_by") @db.Uuid
  generatedAt               DateTime            @map("generated_at") @db.Timestamptz(3)
  finalizedBy               String?             @map("finalized_by") @db.Uuid
  finalizedAt               DateTime?           @map("finalized_at") @db.Timestamptz(3)
  paidAt                    DateTime?           @map("paid_at") @db.Timestamptz(3)
  totalGross                Decimal             @default(0) @map("total_gross") @db.Decimal(15, 2)
  totalAttendanceAdjustment Decimal             @default(0) @map("total_attendance_adjustment") @db.Decimal(15, 2)
  totalDeductions           Decimal             @default(0) @map("total_deductions") @db.Decimal(15, 2)
  totalBonuses              Decimal             @default(0) @map("total_bonuses") @db.Decimal(15, 2)
  totalNet                  Decimal             @default(0) @map("total_net") @db.Decimal(15, 2)
  createdAt                 DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  generator User          @relation("payroll_generated_by", fields: [generatedBy], references: [id], onDelete: Restrict)
  finalizer User?         @relation("payroll_finalized_by", fields: [finalizedBy], references: [id], onDelete: Restrict)
  lines     PayrollLine[]

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("payroll_periods")
}

/// DOCUMENT 06 §3.24 — one per employee per period. Locked lines are
/// immutable in the database (trigger), not only in the application.
model PayrollLine {
  id                   String            @id @db.Uuid
  payrollPeriodId      String            @map("payroll_period_id") @db.Uuid
  companyId            String            @map("company_id") @db.Uuid
  employeeId           String            @map("employee_id") @db.Uuid
  baseSalary           Decimal           @map("base_salary") @db.Decimal(15, 2)
  dailyWage            Decimal           @map("daily_wage") @db.Decimal(15, 2)
  workingDays          Int               @map("working_days") @db.SmallInt
  presentDays          Int               @map("present_days") @db.SmallInt
  wfhDays              Int               @map("wfh_days") @db.SmallInt
  absentDays           Int               @map("absent_days") @db.SmallInt
  paidLeaveDays        Int               @map("paid_leave_days") @db.SmallInt
  unpaidLeaveDays      Int               @map("unpaid_leave_days") @db.SmallInt
  lateMinutesTotal     Int               @map("late_minutes_total")
  attendanceAdjustment Decimal           @map("attendance_adjustment") @db.Decimal(15, 2)
  totalDeductions      Decimal           @default(0) @map("total_deductions") @db.Decimal(15, 2)
  totalBonuses         Decimal           @default(0) @map("total_bonuses") @db.Decimal(15, 2)
  netSalary            Decimal           @map("net_salary") @db.Decimal(15, 2)
  status               PayrollLineStatus @default(calculated)
  snapshot             Json
  isLocked             Boolean           @default(false) @map("is_locked")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  period      PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee    Employee            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  deductions  PayrollDeduction[]
  bonuses     PayrollBonus[]
  adjustments PayrollAdjustment[]

  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId, payrollPeriodId])
  @@index([companyId])
  @@map("payroll_lines")
}

/// DOCUMENT 06 §3.25 — append-only.
model PayrollDeduction {
  id            String   @id @db.Uuid
  payrollLineId String   @map("payroll_line_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  type          String   @db.VarChar(50)
  amount        Decimal  @db.Decimal(15, 2)
  reason        String   @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  line    PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Restrict)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator User        @relation("deduction_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([payrollLineId])
  @@map("payroll_deductions")
}

/// DOCUMENT 06 §3.25 — append-only.
model PayrollBonus {
  id            String   @id @db.Uuid
  payrollLineId String   @map("payroll_line_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  type          String   @db.VarChar(50)
  amount        Decimal  @db.Decimal(15, 2)
  reason        String   @db.Text
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  line    PayrollLine @relation(fields: [payrollLineId], references: [id], onDelete: Restrict)
  company Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  creator User        @relation("bonus_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([payrollLineId])
  @@map("payroll_bonuses")
}

/// DOCUMENT 06 §3.26 — the only legal path to changing a finalized outcome.
model PayrollAdjustment {
  id                    String    @id @db.Uuid
  originalPayrollLineId String    @map("original_payroll_line_id") @db.Uuid
  companyId             String    @map("company_id") @db.Uuid
  employeeId            String    @map("employee_id") @db.Uuid
  amount                Decimal   @db.Decimal(15, 2)
  reason                String    @db.Text
  createdBy             String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  approvedBy            String?   @map("approved_by") @db.Uuid
  approvedAt            DateTime? @map("approved_at") @db.Timestamptz(3)

  line     PayrollLine @relation(fields: [originalPayrollLineId], references: [id], onDelete: Restrict)
  company  Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  creator  User        @relation("adjustment_created_by", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User?       @relation("adjustment_approved_by", fields: [approvedBy], references: [id], onDelete: Restrict)

  @@index([originalPayrollLineId])
  @@index([employeeId])
  @@map("payroll_adjustments")
}

/// DOCUMENT 08 §8 — a repeated `Idempotency-Key` replays the stored resource.
model IdempotencyKey {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  scope       String   @db.VarChar(100)
  key         String   @db.VarChar(255)
  requestHash String   @map("request_hash") @db.Char(64)
  resourceId  String   @map("resource_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, userId, scope, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 13 — warehouse (DOCUMENT 06 §3.28–3.32, DOCUMENT 17)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.28. One stock model: an online channel is `type = online`.
enum WarehouseType {
  main
  branch
  store
  production
  online

  @@map("warehouse_type")
}

enum ProductStatus {
  active
  discontinued

  @@map("product_status")
}

/// DOCUMENT 06 §3.32 — every type; Phase 13 writes only the two transfer legs.
enum StockMovementType {
  purchase
  sale
  transfer_in
  transfer_out
  adjustment
  return
  damage
  manual_addition
  manual_removal

  @@map("stock_movement_type")
}

/// DOCUMENT 06 §3.28. Never hard-deleted; cannot be deactivated while it holds stock (trigger).
model Warehouse {
  id        String        @id @db.Uuid
  companyId String        @map("company_id") @db.Uuid
  nameAr    String        @map("name_ar") @db.VarChar(200)
  nameEn    String        @map("name_en") @db.VarChar(200)
  type      WarehouseType
  address   String?       @db.Text
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(3)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  stock     ProductStock[]
  movements StockMovement[]

  @@index([companyId])
  @@map("warehouses")
}

/// DOCUMENT 06 §3.29 — the Phase 13 subset; Phase 14 adds the catalogue fields.
model Product {
  id           String        @id @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  nameAr       String        @map("name_ar") @db.VarChar(200)
  nameEn       String        @map("name_en") @db.VarChar(200)
  sku          String        @db.VarChar(50)
  categoryId   String?       @map("category_id") @db.Uuid
  unit         String        @db.VarChar(20)
  minStock     Decimal       @default(0) @map("min_stock") @db.Decimal(15, 3)
  costPrice    Decimal       @default(0) @map("cost_price") @db.Decimal(15, 2)
  sellingPrice Decimal       @default(0) @map("selling_price") @db.Decimal(15, 2)
  supplierId   String?       @map("supplier_id") @db.Uuid
  /// The image attachment's id (related_type 'product').
  imagePath    String?       @map("image_path") @db.VarChar(500)
  description  String?       @db.Text
  status       ProductStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz(3)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category  ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier  Supplier?        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  stock     ProductStock[]
  movements StockMovement[]

  @@unique([companyId, sku])
  @@index([categoryId])
  @@index([supplierId])
  @@map("products")
}

model ProductCategory {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  nameAr    String    @map("name_ar") @db.VarChar(200)
  nameEn    String    @map("name_en") @db.VarChar(200)
  parentId  String?   @map("parent_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("product_category_parent", fields: [parentId], references: [id], onDelete: Restrict)
  children ProductCategory[] @relation("product_category_parent")
  products Product[]

  @@index([companyId])
  @@map("product_categories")
}

model Supplier {
  id            String         @id @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  name          String         @db.VarChar(200)
  contactPerson String?        @map("contact_person") @db.VarChar(200)
  phone         String?        @db.VarChar(30)
  email         String?        @db.VarChar(254)
  address       String?        @db.Text
  status        SupplierStatus @default(active)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?      @map("deleted_at") @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  products Product[]

  @@index([companyId])
  @@map("suppliers")
}

enum SupplierStatus {
  active
  inactive

  @@map("supplier_status")
}

/// DOCUMENT 06 §3.31 — a derived cache. Its quantity must equal the latest
/// movement's balance (trigger); only the stock ledger service writes it.
model ProductStock {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(15, 3)
  averageCost Decimal  @default(0) @map("average_cost") @db.Decimal(15, 2)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([companyId])
  @@map("product_stock")
}

/// DOCUMENT 06 §3.32 — the source of truth. Immutable (trigger + no grants).
model StockMovement {
  id              String            @id @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  productId       String            @map("product_id") @db.Uuid
  warehouseId     String            @map("warehouse_id") @db.Uuid
  type            StockMovementType
  quantity        Decimal           @db.Decimal(15, 3)
  unitCost        Decimal?          @map("unit_cost") @db.Decimal(15, 2)
  balanceAfter    Decimal           @map("balance_after") @db.Decimal(15, 3)
  referenceType   String?           @map("reference_type") @db.VarChar(50)
  referenceId     String?           @map("reference_id") @db.Uuid
  transferGroupId String?           @map("transfer_group_id") @db.Uuid
  reason          String?           @db.Text
  createdBy       String            @map("created_by") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Ledger order (Phase 14): assigned at insert, under the balance's row lock.
  sequence        BigInt            @unique @default(autoincrement())

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  creator   User      @relation("stock_movement_created_by", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([companyId, productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([transferGroupId])
  @@index([productId, warehouseId, createdAt, id], map: "stock_movements_product_warehouse_idx")
  @@index([productId, warehouseId, sequence], map: "stock_movements_product_warehouse_sequence_idx")
  @@index([companyId, sequence])
  @@index([companyId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Reports — Phase 12 (DOCUMENT 06 §3.27, DOCUMENT 18)
// ---------------------------------------------------------------------------

/// DOCUMENT 06 §3.27 — the only persisted reporting snapshot in V1. A snapshot,
/// changed only by an explicit, audited regeneration: the database refuses an
/// UPDATE that does not raise `revision` by one. `sourceFingerprint` is the
/// SHA-256 of the content as computed from the sources, so a read can prove
/// whether the underlying data has changed since (DOCUMENT 18 rule 2).
model MonthlyEmployeeReport {
  id                String   @id @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  year              Int      @db.SmallInt
  month             Int      @db.SmallInt
  attendanceSummary Json     @map("attendance_summary")
  taskSummary       Json     @map("task_summary")
  goalSummary       Json     @map("goal_summary")
  salarySummary     Json     @map("salary_summary")
  performanceScores Json     @map("performance_scores")
  overallScore      Decimal? @map("overall_score") @db.Decimal(5, 2)
  generatedAt       DateTime @map("generated_at") @db.Timestamptz(3)
  generatedBy       String   @map("generated_by") @db.Uuid
  isProvisional     Boolean  @map("is_provisional")
  sourceFingerprint String   @map("source_fingerprint") @db.Char(64)
  revision          Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  generator User     @relation("monthly_report_generated_by", fields: [generatedBy], references: [id], onDelete: Restrict)

  @@unique([employeeId, year, month])
  @@index([companyId, year, month])
  @@map("monthly_employee_reports")
}

/// DOCUMENT 18 "Performance": long-running exports run as background jobs.
/// A job's status and its finished file — never a reporting truth.
enum ReportExportStatus {
  queued
  running
  completed
  failed

  @@map("report_export_status")
}

model ReportExport {
  id            String             @id @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  requestedBy   String             @map("requested_by") @db.Uuid
  reportKey     String             @map("report_key") @db.VarChar(40)
  format        String             @db.VarChar(10)
  filters       Json
  scope         Json
  locale        String             @db.VarChar(5)
  status        ReportExportStatus @default(queued)
  rowCount      Int?               @map("row_count")
  storageKey    String?            @map("storage_key") @db.VarChar(500)
  failureReason String?            @map("failure_reason") @db.Text
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(3)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requester User    @relation("report_export_requested_by", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([companyId, requestedBy, createdAt])
  @@map("report_exports")
}

// ---------------------------------------------------------------------------
// Notifications — Phase 15 (DOCUMENT 06 §3.34, DOCUMENT 19)
// ---------------------------------------------------------------------------

/// DOCUMENT 19's admin / manager and employee tables, plus DOCUMENT 18's
/// background-export completion and failure.
enum NotificationType {
  leave_request_submitted
  attendance_correction_submitted
  request_submitted
  task_overdue
  low_stock
  out_of_stock
  goal_milestone
  payroll_ready
  employee_missing_checkout
  tasks_need_reassignment
  task_assigned
  task_deadline_approaching
  task_updated
  leave_approved
  leave_rejected
  correction_approved
  correction_rejected
  request_reviewed
  salary_finalized
  goal_assigned
  monthly_report_ready
  missing_checkout
  report_export_completed
  report_export_failed

  @@map("notification_type")
}

/// DOCUMENT 19 "Channels": `in_app` is V1; `email` and `push` are the
/// architecture's future dispatchers and are never written in V1.
enum NotificationChannel {
  in_app
  email
  push

  @@map("notification_channel")
}

enum NotificationPriority {
  high
  medium
  low

  @@map("notification_priority")
}

/// One row per processed source event: what makes delivery idempotent and
/// DOCUMENT 19 rule 3's "once per crossing / once per task" enforceable.
model NotificationEvent {
  id        String   @id @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  eventKey  String   @map("event_key") @db.VarChar(200)
  eventType String   @map("event_type") @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([companyId, eventKey])
  @@index([companyId, createdAt])
  @@map("notification_events")
}

/// DOCUMENT 06 §3.34. Both language variants are stored (DOCUMENT 19 "Data").
/// A summary (`groupCount` > 1, DOCUMENT 19 rule 4) links to the list of its
/// type; the rows it absorbed carry `groupedIntoId` and leave the feed.
model Notification {
  id            String               @id @db.Uuid
  companyId     String               @map("company_id") @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  type          NotificationType
  priority      NotificationPriority
  /// `admin` (the admin / manager table) or `employee` — which side opens it.
  audience      String               @db.VarChar(10)
  channel       NotificationChannel  @default(in_app)
  titleAr       String               @map("title_ar") @db.VarChar(300)
  titleEn       String               @map("title_en") @db.VarChar(300)
  bodyAr        String               @map("body_ar") @db.VarChar(1000)
  bodyEn        String               @map("body_en") @db.VarChar(1000)
  relatedType   String               @map("related_type") @db.VarChar(40)
  relatedId     String?              @map("related_id") @db.Uuid
  eventId       String?              @map("event_id") @db.Uuid
  groupCount    Int                  @default(1) @map("group_count")
  groupedIntoId String?              @map("grouped_into_id") @db.Uuid
  handledAt     DateTime?            @map("handled_at") @db.Timestamptz(3)
  readAt        DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company     Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  event       NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  groupedInto Notification?      @relation("notification_group", fields: [groupedIntoId], references: [id], onDelete: Cascade)
  grouped     Notification[]     @relation("notification_group")

  @@index([userId, readAt, createdAt])
  @@index([userId, type, createdAt])
  @@index([companyId, relatedType, relatedId])
  @@index([companyId, createdAt])
  @@index([groupedIntoId])
  @@map("notifications")
}

/// DOCUMENT 19 rule 10 — per-event channel preferences in company settings.
/// No row means the default: enabled.
model CompanyNotificationSetting {
  companyId String              @map("company_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel
  enabled   Boolean
  updatedBy String              @map("updated_by") @db.Uuid
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  updater User    @relation("notification_setting_updated_by", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@id([companyId, type, channel])
  @@map("company_notification_settings")
}
